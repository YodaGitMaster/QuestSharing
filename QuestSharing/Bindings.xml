<Bindings>
    <Binding name="QUESTSHARING_QUICKCHAT" header="QUESTSHARING" runOnUp="true">
        if keystate == "down" then
            QuestSharing_QuickDown()
        else
            QuestSharing_QuickUp()
        end
    </Binding>
    <Binding name="QUESTSHARING_LFGSCAN" header="QUESTSHARING">
        QuestSharing_LFGScan()
    </Binding>
</Bindings>
