  %% Fix the audited bugs: planner regressions, map search, dungeon menu — three parallel streams with reviews · 8 agents: 4 × bpmn:worker, 4 × bpmn:reviewer · up to 14 with loop rounds
  subgraph n_lane_builder["🤖 Builder · bpmn:worker"]
    n_start(("Fix plan approved"))
    n_split{"+"}
    n_build_a["⚙ Fix planner regressions · ⏱ 50 min"]
    n_fix_a["⚙ Fix planner review issues · ⏱ 25 min"]
    n_build_b["⚙ Fix map search typing · ⏱ 45 min"]
    n_fix_b["⚙ Fix map search issues · ⏱ 25 min"]
    n_build_c["⚙ Keep dungeon menu open · ⏱ 15 min"]
    n_fix_c["⚙ Fix dungeon review issues · ⏱ 15 min"]
    n_integrate["⚙ Integrate and run suite · ⏱ 20 min"]
    n_review_a__merge{"✕"}
    n_review_b__merge{"✕"}
    n_review_c__merge{"✕"}
  end
  subgraph n_lane_reviewer["🤖 Reviewer · bpmn:reviewer · ⏱ 15 min"]
    n_review_a["⚙ Review planner fixes"]
    n_ok_a{"Planner fixes approved?"}
    n_review_b["⚙ Review map search fix"]
    n_ok_b{"Map search fix approved?"}
    n_review_c["⚙ Review dungeon menu fix"]
    n_ok_c{"Dungeon fix approved?"}
    n_join{"+"}
    n_final_review["⚙ Review integrated tree · ⏱ 20 min"]
    n_done((("Fixes integrated")))
  end
  n_start --> n_split
