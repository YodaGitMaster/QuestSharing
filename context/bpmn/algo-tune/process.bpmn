    <bpmn:sequenceFlow id="f_ok_plan_fix_plan" name="changes" sourceRef="ok_plan" targetRef="fix_plan" />
    <bpmn:sequenceFlow id="f_fix_plan_review_plan" sourceRef="fix_plan" targetRef="review_plan__merge" />
    <bpmn:sequenceFlow id="f_join_integrate" sourceRef="join" targetRef="integrate" />
    <bpmn:sequenceFlow id="f_integrate_final_review" sourceRef="integrate" targetRef="final_review" />
    <bpmn:sequenceFlow id="f_final_review_done" sourceRef="final_review" targetRef="done" />
    <bpmn:sequenceFlow id="f_split_build_g" sourceRef="split" targetRef="build_g" />
    <bpmn:sequenceFlow id="f_build_g_review_g" sourceRef="build_g" targetRef="review_g__merge" />
    <bpmn:sequenceFlow id="f_review_g_ok_g" sourceRef="review_g" targetRef="ok_g" />
    <bpmn:sequenceFlow id="f_ok_g_join" name="approved or 2nd round" sourceRef="ok_g" targetRef="join" claude:when="{&quot;any&quot;:[{&quot;path&quot;:&quot;verdict_g.status&quot;,&quot;eq&quot;:&quot;approved&quot;},{&quot;path&quot;:&quot;$loop.ok_g&quot;,&quot;gte&quot;:2}]}">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">(verdict_g.status == &quot;approved&quot;) || ($loop.ok_g &gt;= 2)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_ok_g_fix_g" name="changes" sourceRef="ok_g" targetRef="fix_g" />
    <bpmn:sequenceFlow id="f_fix_g_review_g" sourceRef="fix_g" targetRef="review_g__merge" />
    <bpmn:sequenceFlow id="f_review_opt__merge_review_opt" sourceRef="review_opt__merge" targetRef="review_opt" />
