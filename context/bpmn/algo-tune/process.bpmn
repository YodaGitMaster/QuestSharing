    <bpmn:sequenceFlow id="f_review_plan_ok_plan" sourceRef="review_plan" targetRef="ok_plan" />
    <bpmn:sequenceFlow id="f_ok_plan_join" name="approved or 2nd round" sourceRef="ok_plan" targetRef="join" claude:when="{&quot;any&quot;:[{&quot;path&quot;:&quot;verdict_plan.status&quot;,&quot;eq&quot;:&quot;approved&quot;},{&quot;path&quot;:&quot;$loop.ok_plan&quot;,&quot;gte&quot;:2}]}">
