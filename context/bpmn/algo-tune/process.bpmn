    <bpmn:sequenceFlow id="f_review_opt_ok_opt" sourceRef="review_opt" targetRef="ok_opt" />
    <bpmn:sequenceFlow id="f_ok_opt_join" name="approved or 2nd round" sourceRef="ok_opt" targetRef="join" claude:when="{&quot;any&quot;:[{&quot;path&quot;:&quot;verdict_opt.status&quot;,&quot;eq&quot;:&quot;approved&quot;},{&quot;path&quot;:&quot;$loop.ok_opt&quot;,&quot;gte&quot;:2}]}">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">(verdict_opt.status == &quot;approved&quot;) || ($loop.ok_opt &gt;= 2)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_ok_opt_fix_opt" name="changes" sourceRef="ok_opt" targetRef="fix_opt" />
    <bpmn:sequenceFlow id="f_fix_opt_review_opt" sourceRef="fix_opt" targetRef="review_opt__merge" />
    <bpmn:sequenceFlow id="f_split_build_plan" sourceRef="split" targetRef="build_plan" />
