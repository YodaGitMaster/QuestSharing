      <bpmn:outgoing>f_review_opt_ok_opt</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_review_opt"><bpmn:targetRef>DOR_review_opt</bpmn:targetRef></bpmn:dataOutputAssociation>
