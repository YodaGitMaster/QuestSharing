    <bpmn:serviceTask id="integrate" name="Integrate and run suite" claude:agent="bpmn:worker" claude:out="integration" claude:in="patch_opt,patch_plan,verdict_opt,verdict_plan,patch_g,verdict_g" claude:timeout="20">
      <bpmn:incoming>f_join_integrate</bpmn:incoming>
