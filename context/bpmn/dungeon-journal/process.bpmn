    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_ok_m_fix_m" name="changes" sourceRef="ok_m" targetRef="fix_m" />
    <bpmn:sequenceFlow id="f_fix_m_review_m" sourceRef="fix_m" targetRef="review_m__merge" />
    <bpmn:sequenceFlow id="f_join_integrate" sourceRef="join" targetRef="integrate" />
