      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">$loop.ok_a &gt;= 3</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_ok_a_fix_a" name="changes" sourceRef="ok_a" targetRef="fix_a" />
    <bpmn:sequenceFlow id="f_fix_a_review_a" sourceRef="fix_a" targetRef="review_a__merge" />
