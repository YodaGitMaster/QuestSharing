    <bpmn:sequenceFlow id="f_ok_a_join" name="approved" sourceRef="ok_a" targetRef="join" claude:when="{&quot;path&quot;:&quot;vA.status&quot;,&quot;eq&quot;:&quot;approved&quot;}">
