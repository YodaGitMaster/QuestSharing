    <bpmn:sequenceFlow id="f_ok_final_done" name="approved" sourceRef="ok_final" targetRef="done" claude:when="{&quot;path&quot;:&quot;vF.status&quot;,&quot;eq&quot;:&quot;approved&quot;}">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">vF.status == &quot;approved&quot;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_ok_final_open_issues" name="3rd round" sourceRef="ok_final" targetRef="open_issues" claude:when="{&quot;path&quot;:&quot;$loop.ok_final&quot;,&quot;gte&quot;:3}">
