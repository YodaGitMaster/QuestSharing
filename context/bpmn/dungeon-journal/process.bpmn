    <bpmn:sequenceFlow id="f_build_m_review_m" sourceRef="build_m" targetRef="review_m__merge" />
    <bpmn:sequenceFlow id="f_review_m_ok_m" sourceRef="review_m" targetRef="ok_m" />
    <bpmn:sequenceFlow id="f_ok_m_join" name="approved" sourceRef="ok_m" targetRef="join" claude:when="{&quot;path&quot;:&quot;vM.status&quot;,&quot;eq&quot;:&quot;approved&quot;}">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">vM.status == &quot;approved&quot;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_ok_m_join_2" name="3rd round" sourceRef="ok_m" targetRef="join" claude:when="{&quot;path&quot;:&quot;$loop.ok_m&quot;,&quot;gte&quot;:3}">
