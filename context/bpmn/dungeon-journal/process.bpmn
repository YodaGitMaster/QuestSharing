    <bpmn:sequenceFlow id="f_ok_d_join_2" name="3rd round" sourceRef="ok_d" targetRef="join" claude:when="{&quot;path&quot;:&quot;$loop.ok_d&quot;,&quot;gte&quot;:3}">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">$loop.ok_d &gt;= 3</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_ok_d_fix_d" name="changes" sourceRef="ok_d" targetRef="fix_d" />
