  %% Dungeon quests tab in the Dungeon Journal look · 10 agents: 5 × bpmn:worker, 5 × bpmn:reviewer · up to 30 with loop rounds
  subgraph n_lane_builder["🤖 Builder · bpmn:worker · ⏱ 40 min"]
    n_start(("Plan approved"))
    n_split{"+"}
    n_build_a["⚙ Build theme and home"]
    n_fix_a["⚙ Fix theme and home"]
    n_build_b["⚙ Build quests page and shell"]
    n_fix_b["⚙ Fix quests page"]
    n_build_d["⚙ Build bosses and drops"]
    n_fix_d["⚙ Fix bosses and drops"]
    n_build_m["⚙ Build map and route pages"]
    n_fix_m["⚙ Fix map and route"]
    n_integrate["⚙ Integrate and run suite · ⏱ 30 min"]
    n_fix_final["⚙ Fix final issues · ⏱ 25 min"]
    n_review_a__merge{"✕"}
    n_review_b__merge{"✕"}
    n_review_d__merge{"✕"}
    n_review_m__merge{"✕"}
    n_final_review__merge{"✕"}
  end
  subgraph n_lane_reviewer["🤖 Reviewer · bpmn:reviewer · ⏱ 12 min"]
    n_review_a["⚙ Review theme and home"]
    n_ok_a{"A approved?"}
    n_review_b["⚙ Review quests page"]
    n_ok_b{"B approved?"}
    n_review_d["⚙ Review bosses and drops"]
