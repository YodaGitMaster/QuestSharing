    <bpmn:sequenceFlow id="f_ok_b1_join" name="approved or 2nd round" sourceRef="ok_b1" targetRef="join" claude:when="{&quot;any&quot;:[{&quot;path&quot;:&quot;verdict_b1.status&quot;,&quot;eq&quot;:&quot;approved&quot;},{&quot;path&quot;:&quot;$loop.ok_b1&quot;,&quot;gte&quot;:2}]}">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">(verdict_b1.status == &quot;approved&quot;) || ($loop.ok_b1 &gt;= 2)</bpmn:conditionExpression>
